# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local a GitHub.

# URL pública del sitio (sitemap, Open Graph). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contacto público. Si se dejan vacíos, los botones de email/WhatsApp no se muestran.
NEXT_PUBLIC_CONTACT_EMAIL=
# Formato internacional sin "+" ni espacios, p. ej. 34600000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Resend (fase 1: envío real de formularios). Sin estas variables, los formularios responden
# "integración no configurada" en lugar de simular un envío correcto.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Relevo <hola@tudominio.com>"
RESEND_FROM_EMAIL=
# Buzón interno que recibe las solicitudes
CONTACT_INBOX_EMAIL=

# --- Fases siguientes (no se usan todavía) ---
# Supabase (fase 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe en modo test (fase 3). Usa claves sk_test_/pk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
